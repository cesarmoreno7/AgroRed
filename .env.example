NODE_ENV=development

# ── API Gateway ──────────────────────────────────────────────────
API_GATEWAY_PORT=8080
API_GATEWAY_CORS_ORIGIN=http://localhost:5173
# Comma-separated for multiple origins, e.g.: http://localhost:5173,https://app.agrored.co
API_GATEWAY_ORIGIN=http://localhost:8080

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agrored
POSTGRES_USER=agrored_user
POSTGRES_PASSWORD=change_me_in_production!!

# ── JWT ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_in_production_min_32_chars!!
JWT_EXPIRES_IN=8h

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Service URLs ─────────────────────────────────────────────────
USER_SERVICE_URL=http://localhost:3001
PRODUCER_SERVICE_URL=http://localhost:3002
OFFER_SERVICE_URL=http://localhost:3003
RESCUE_SERVICE_URL=http://localhost:3004
DEMAND_SERVICE_URL=http://localhost:3005
INVENTORY_SERVICE_URL=http://localhost:3006
LOGISTICS_SERVICE_URL=http://localhost:3007
INCIDENT_SERVICE_URL=http://localhost:3008
ANALYTICS_SERVICE_URL=http://localhost:3009
NOTIFICATION_SERVICE_URL=http://localhost:3010
ML_SERVICE_URL=http://localhost:3011
AUTOMATION_SERVICE_URL=http://localhost:3012
AUCTION_SERVICE_URL=http://localhost:3013
INSTITUTION_SERVICE_URL=http://localhost:3014

# ── Service-to-service auth (shared secret for internal calls) ───
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=change_me_internal_secret!!

# ── Frontend URL (user-service — recovery links) ─────────────────
FRONTEND_URL=http://localhost:5173

# ── OSRM Routing (logistics-service) ────────────────────────────
OSRM_URL=https://router.project-osrm.org

# ── Web Dashboard (set in apps/web-dashboard/.env) ──────────────
# Leave empty to use Vite dev proxy (development)
# In production: VITE_API_BASE_URL=https://gateway.agrored.co
VITE_API_BASE_URL=

# ════════════════════════════════════════════════════════════════
# CANALES DE NOTIFICACIÓN — notification-service
# ════════════════════════════════════════════════════════════════

# ── Canal 1: Email / SMTP ────────────────────────────────────────
# Proveedor recomendado: Gmail (con App Password), SendGrid o Brevo
# Para Gmail: activar verificación en 2 pasos y crear App Password en:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_HOST=smtp.sendgrid.net   # SendGrid
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_HOST=smtp-relay.brevo.com # Brevo (ex-Sendinblue)
# SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_or_api_key
SMTP_FROM=noreply@agrored.co

# ── Canal 2: Email (user-service — recuperación de contraseña) ───
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ── Canal 3: WhatsApp / Meta Cloud API ──────────────────────────
# Registrar en: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# 1. Crear app en Meta for Developers
# 2. Agregar producto WhatsApp Business
# 3. Copiar Phone Number ID y Access Token
# 4. Configurar webhook apuntando a: POST /api/v1/notifications/webhooks/whatsapp
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_API_VERSION=v19.0
# URL base de la API de WhatsApp (no modificar en producción)
WHATSAPP_API_URL=https://graph.facebook.com

# ── Canal 4: SMS / Twilio ────────────────────────────────────────
# Registrar en: https://www.twilio.com/try-twilio
# Obtener desde Console en: https://console.twilio.com/
# Costo aproximado: USD $0.0085 por SMS en Colombia
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+12345678901
# Formato del número de destino: +57XXXXXXXXXX (código país Colombia: +57)
# Ejemplo: TWILIO_TO_NUMBER=+573001234567

# ── Canal 5: In-App / WebSocket ─────────────────────────────────
# Las notificaciones in-app se gestionan mediante SSE (Server-Sent Events)
# usando el mismo Redis ya configurado. No requiere credenciales adicionales.
# El servicio publica eventos en el canal: agrored:notifications:{tenantId}
# El frontend se suscribe vía GET /api/v1/notifications/stream
# Configuración del canal de Redis para pub/sub:
NOTIFICATION_REDIS_CHANNEL_PREFIX=agrored:notifications
# Timeout en ms para conexiones SSE inactivas (15 minutos por defecto):
NOTIFICATION_SSE_TIMEOUT_MS=900000
# Heartbeat interval en ms para mantener conexiones SSE vivas (30 s):
NOTIFICATION_SSE_HEARTBEAT_MS=30000

# ── Configuración global de notificaciones ───────────────────────
# Canales activos (separados por coma). Valores: email, whatsapp, sms, inapp
# Si un canal no está configurado, se ignorará aunque aparezca aquí.
NOTIFICATION_CHANNELS_ENABLED=email,inapp

# Número máximo de reintentos antes de marcar una notificación como fallida:
NOTIFICATION_MAX_RETRIES=3

# Tiempo en ms entre reintentos (exponential backoff base):
NOTIFICATION_RETRY_DELAY_MS=5000
